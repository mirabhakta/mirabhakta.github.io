<section class="hero page-gutter" aria-labelledby="hero-title">
  <div class="hero__copy">
    <h1 class="hero__title lines" id="hero-title">
      <span class="hero__line"><span data-line style="--i: 0">Mira</span></span>
      <span class="hero__line hero__line--accent"><span data-line style="--i: 1">Bhakta</span></span>
    </h1>

    <p class="hero__intro" data-load style="--d: 420ms">
      Exploring the space between intelligence, technology, and human experience.
    </p>

    <p class="hero__role" data-load style="--d: 460ms">
      AI systems · Software engineering · Research · Creative technology
    </p>

    <a class="text-link" href="#work" data-load style="--d: 500ms">
      See selected work
      <span class="text-link__arrow" aria-hidden="true">→</span>
      <span class="sr-only">(jump to selected work)</span>
    </a>
  </div>

  <figure class="memory-trace" data-load style="--d: 540ms">
