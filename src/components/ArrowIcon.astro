---
interface Props {
  direction?: 'up-right' | 'down';
}
const { direction = 'up-right' } = Astro.props;
---
<svg class="link-arrow" data-direction={direction} viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d={direction === 'down' ? 'M12 5v14m-6-6 6 6 6-6' : 'M6 18 18 6M6 6h12v12'} /></svg>
