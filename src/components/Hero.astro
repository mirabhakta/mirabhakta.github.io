      viewBox="0 0 320 420"
      role="img"
      aria-labelledby="memory-trace-title memory-trace-desc"
    >
      <title id="memory-trace-title">Context trace</title>
      <desc id="memory-trace-desc">
        A restrained diagram of retrieved fragments connecting into a single path.
      </desc>
      <g class="memory-trace__rows">
        <path d="M0 40h320M0 90h320M0 140h320M0 190h320M0 240h320M0 290h320M0 340h320M0 390h320" />
      </g>
      <g class="memory-trace__fragments">
        <path d="M16 40h92M212 40h92M60 90h140M232 140h72M16 190h104M136 240h168M40 290h84M188 340h116" />
      </g>
      <g class="memory-trace__nodes">
        <circle cx="124" cy="40" r="4" />
        <circle cx="186" cy="140" r="4" />
        <circle cx="152" cy="240" r="4" />
        <circle cx="112" cy="340" r="4" />
      </g>
      <path class="memory-trace__path" d="M124 40C124 96 186 96 186 140C186 196 152 196 152 240C152 296 112 296 112 340" />
    </svg>
    <figcaption class="memory-trace__caption">
      Fragments retrieved, connected, and recomposed.
    </figcaption>
  </figure>
</section>
