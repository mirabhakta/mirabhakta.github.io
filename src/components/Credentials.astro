---
import ArrowIcon from "./ArrowIcon.astro";
---
<section class="experience credentials page-gutter" id="credentials" aria-labelledby="credentials-title">
  <div class="experience__head">
    <h2 id="credentials-title">Recognition<br />&amp; credentials</h2>
  </div>
  <div class="credentials__columns">
    <div>
      <h3 class="credentials__heading">Credentials</h3>
      <dl class="credentials__list">
        <div>
          <dt>AWS Certified Cloud Practitioner</dt>
          <dd>Amazon Web Services · Issued Aug 2026 · Expires Aug 2029</dd>
          <dd><a class="text-link" href="https://www.credly.com/badges/d07ea3b9-8c93-414b-a0b9-388e4b86e0c5/public_url" target="_blank" rel="noopener noreferrer" aria-label="View AWS Certified Cloud Practitioner credential (opens in a new tab)">View credential <ArrowIcon /></a></dd>
        </div>
        <div>
          <dt>AWS Certified AI Practitioner</dt>
          <dd>Amazon Web Services · Issued Jul 2026 · Expires Jul 2029</dd>
          <dd><a class="text-link" href="https://www.credly.com/badges/99eb0580-5753-4761-9b94-373c9faf2e6d/public_url" target="_blank" rel="noopener noreferrer" aria-label="View AWS Certified AI Practitioner credential (opens in a new tab)">View credential <ArrowIcon /></a></dd>
        </div>
        <div>
          <dt>Google AI Professional Certificate</dt>
          <dd>Google · Issued Oct 2026</dd>
          <dd><a class="text-link" href="https://www.coursera.org/account/accomplishments/specialization/6CQOGA01M0C4" target="_blank" rel="noopener noreferrer" aria-label="View Google AI Professional Certificate (opens in a new tab)">View credential <ArrowIcon /></a></dd>
        </div>
      </dl>
      <h3 class="credentials__heading credentials__heading--training">Additional learning</h3>
      <dl class="credentials__list">
        <div>
          <dt>Introduction to Model Context Protocol</dt>
          <dd>Anthropic · Course completion · Jun 2026</dd>
          <dd><a class="text-link" href="https://verify.skilljar.com/c/2pg3n2dp7j9u" target="_blank" rel="noopener noreferrer" aria-label="View Introduction to Model Context Protocol course credential (opens in a new tab)">View credential <ArrowIcon /></a></dd>
        </div>
      </dl>
    </div>
    <div>
      <h3 class="credentials__heading">Recognition</h3>
      <dl class="credentials__list">
        <div>
          <dt>3rd place · CPP AI Hackathon</dt>
          <dd>Wellby · Cal Poly Pomona · 2026</dd>
        </div>
        <div>
          <dt>STEM Advantage Scholar</dt>
          <dd>STEM Advantage · Since June 2024</dd>
        </div>
      </dl>
    </div>
  </div>
</section>
