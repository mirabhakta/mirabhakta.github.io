---
import { nav } from '../data/site';
---

<header class="site-header page-gutter">
  <a class="wordmark" href="#top" aria-label="Mira Bhakta, home">MB</a>

  <nav class="site-nav" id="primary-navigation" aria-label="Primary navigation">
    <ul class="site-nav__list">
      {nav.map((item) => (
        <li>
          <a class="site-nav__link" href={item.href}>{item.label}</a>
        </li>
      ))}
    </ul>
  </nav>

  <button class="site-nav__toggle" type="button" aria-expanded="false" aria-controls="primary-navigation">
    <span class="site-nav__toggle-label">Menu</span>
  </button>
</header>

<script>
  // The nav element carries the id in the markup, so the toggle's
  // aria-controls always points at a real element. The script only adds
  // behaviour; without it the links stay in the document and remain usable.
  const header = document.querySelector('.site-header');
  const toggle = header?.querySelector<HTMLButtonElement>('.site-nav__toggle');
  const nav = header?.querySelector<HTMLElement>('.site-nav');

  if (header && toggle && nav) {
    document.documentElement.classList.add('js');

    const close = () => {
      toggle.setAttribute('aria-expanded', 'false');
      const label = toggle.querySelector('.site-nav__toggle-label');
      if (label) label.textContent = 'Menu';
      header.classList.remove('nav-open');
    };

    const open = () => {
      toggle.setAttribute('aria-expanded', 'true');
      const label = toggle.querySelector('.site-nav__toggle-label');
      if (label) label.textContent = 'Close';
      header.classList.add('nav-open');
    };

    toggle.addEventListener('click', () => {
      if (toggle.getAttribute('aria-expanded') === 'true') close();
      else open();
    });

    // Choosing a destination closes the menu and moves on with it.
    nav.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a')) close();
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && header.classList.contains('nav-open')) {
        close();
        toggle.focus();
      }
    });

    // A resize past the phone breakpoint hides the CSS menu panel; reset the
    // control state so it does not stay stuck open.
    const wide = window.matchMedia('(min-width: 641px)');
    const onWide = () => {
      if (wide.matches) close();
    };
    wide.addEventListener('change', onWide);
  }
</script>
