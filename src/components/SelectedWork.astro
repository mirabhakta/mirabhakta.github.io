---
import ArrowIcon from "./ArrowIcon.astro";
import { projects } from '../data/projects';
import WorkVisual from './WorkVisual.astro';
---
<section class="work page-gutter" id="work" aria-labelledby="work-title">
  <div class="section-head">
    <div><p class="eyebrow">Ideas into software</p><h2 id="work-title">Selected work</h2></div>
    <p>AI systems, data exploration, and tools that make complex information useful.</p>
  </div>
  <div class="project-grid">
    {projects.map((project, index) => (
      <article class={`project project--${project.slug}`}>
        <a class="project__image-link" href={`/work/${project.slug}/`} aria-label={`Explore ${project.name}`}>
          <div class:list={['project__frame', { 'project__frame--diagram': project.visual }]}>{project.visual ? <WorkVisual kind={project.visual} compact /> : <img src={project.preview} alt={project.alt} width={project.width} height={project.height} loading="lazy" decoding="async" />}</div>
          <span class="project__image-arrow" aria-hidden="true">↗</span>
        </a>
        <div class="project__body">
        <div class="project__heading"><h3><a href={`/work/${project.slug}/`}>{project.name}</a></h3><span class="project__number" aria-hidden="true">0{index + 1}</span></div>
        <p class="project__kind">{project.kind}</p>
        <p class="project__summary">{project.summary}</p>
        <p class="project__stack">{project.shortStack}</p>
        <a class="text-link" href={`/work/${project.slug}/`}>Explore {project.name} <ArrowIcon /></a>
        </div>
      </article>
    ))}
  </div>
</section>
