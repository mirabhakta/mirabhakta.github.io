---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Contact from '../../components/Contact.astro';
import { projects } from '../../data/projects';
import WorkVisual from '../../components/WorkVisual.astro';
export function getStaticPaths() {
  return projects.map(project => ({ params: { slug: project.slug }, props: { project } }));
}
const { project } = Astro.props;
---
<BaseLayout title={`${project.name} — Mira Bhakta`} description={project.summary} image={project.preview}>
  <Nav />
  <main id="main" class={`detail detail--${project.slug} page-gutter`}>
    <a class="back-link" href="/#work">← Back to selected work</a>
    <header class="detail__header">
      <p class="eyebrow">{project.kind}</p><h1>{project.name}</h1>
      <p class="detail__lead">{project.summary}</p><p class="detail__status">{project.status}</p>
      <div class="detail__actions">
        {project.href && <a class="btn-primary" href={project.href} target="_blank" rel="noopener noreferrer">View code on GitHub <span aria-hidden="true">↗</span><span class="sr-only">(opens in a new tab)</span></a>}
        {!project.href && <a class="btn-primary" href={`mailto:miraabhakta@gmail.com?subject=${encodeURIComponent(project.name + ' — project inquiry')}`}>Ask about {project.name} <span aria-hidden="true">↗</span></a>}
      </div>
    </header>
    <figure class="detail__figure">
      {project.visual ? <div class="detail__image-frame"><WorkVisual kind={project.visual} /></div> : <a class="detail__image-frame" href={project.preview} aria-label={`Open full-size ${project.name} image`}><img src={project.preview} alt={project.alt} width={project.width} height={project.height} /></a>}
      <figcaption>{project.visual ? project.visualCaption : `${project.caption} Select the image to view it full size.`}</figcaption>
    </figure>
    {project.slug === 'voicestudio-live' && <details class="source-screenshot"><summary>View earlier workspace screenshot</summary><figure><a href={project.preview}><img src={project.preview} alt={project.alt} width={project.width} height={project.height} loading="lazy" /></a><figcaption>{project.caption}</figcaption></figure></details>}
    <div class="detail__sections">
      {project.upstream && <section><h2>Built on open source</h2><div><p>This project extends the existing VoiceStudio app and integrates Applio for RVC inference. The original app and inference engine are credited to their upstream authors; the live-vocal extension is my contribution.</p><ul class="upstream-links">{project.upstream.map(source => <li><a href={source.href} target="_blank" rel="noopener noreferrer">{source.name} <span aria-hidden="true">↗</span><span class="sr-only">(opens in a new tab)</span></a></li>)}</ul></div></section>}
      <section><h2>Purpose</h2><p>{project.purpose}</p></section>
      <section><h2>How it works</h2><p>{project.description}</p>
        {project.slug === 'contextos' && <figure class="context-flow" aria-label="Explanatory diagram: import conversations, review source-backed claims, export approved context"><ol><li><span>01</span>Import conversations</li><li><span>02</span>Review claims + sources</li><li><span>03</span>Export approved context</li></ol><figcaption>Explanatory workflow diagram · not an application screenshot.</figcaption></figure>}
      </section>
      <section><h2>Project & contribution</h2><p>{project.contribution}</p></section>
      <section><h2>{project.stack ? 'Technologies' : 'Focus'}</h2><p>{project.stack || project.shortStack}</p></section>
    </div>
    <nav class="detail__more" aria-label="Other projects"><p class="eyebrow">Keep exploring</p>{projects.filter(p => p.slug !== project.slug).map(p => <a class="text-link" href={`/work/${p.slug}/`}>{p.name} <span aria-hidden="true">↗</span></a>)}</nav>
  </main>
  <Contact />
</BaseLayout>
